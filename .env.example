# คัดลอกเป็น .env.local แล้วใส่ค่าจริง (.env.local ถูก gitignore ไว้แล้ว)
# หาได้ที่ Supabase Dashboard > Project Settings > API
#
# ค่า 2 ตัวนี้ "เปิดเผยได้" (ถูกฝังในเว็บอยู่แล้ว) ความปลอดภัยมาจาก RLS ใน supabase/schema.sql
# ห้ามใส่ service_role / secret key ที่นี่หรือใน Vercel
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
